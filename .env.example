# ===========================================
# PubMatcher - Environment Configuration
# ===========================================
# INSTRUCTIONS:
# 1. Rename this file to .env
# 2. Fill in the REQUIRED values
# 3. Optional features will be disabled if not configured
# ===========================================


# ===========================================
# [REQUIRED] Server Configuration
# ===========================================
PORT=3000
NODE_ENV=production


# ===========================================
# [REQUIRED] PostgreSQL Database
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pubmatcher
DB_USER=pubmatcher
DB_PASSWORD=CHANGE_ME


# ===========================================
# [REQUIRED] JWT Authentication Secret
# ===========================================
# Used for user login/session tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=CHANGE_ME_RANDOM_SECRET


# ===========================================
# [OPTIONAL] Email Configuration
# ===========================================
# If not configured:
#   - Password reset will return an error
#   - Bug reports will return an error
# The app will still work, these features just won't be available
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# NOREPLY_USER=noreply@yourdomain.com
# NOREPLY_PASS=your_email_password
# ADMIN_USER=admin@yourdomain.com


# ===========================================
# [OPTIONAL] Mastodon Integration
# ===========================================
# If not configured:
#   - Mastodon feed will return an empty array
#   - The app works normally without it
#
# MASTODON_TOKEN=your_mastodon_access_token


# ===========================================
# [OPTIONAL] Google Analytics (Frontend)
# ===========================================
# If not configured:
#   - No analytics tracking
#   - The app works normally without it
#
# VUE_APP_GA_TRACKING_ID=G-XXXXXXXXXX
